{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  // A `build.ts` or `*.node.ts` under src is a per-game Node script living beside
  // the game data it emits (asset generators, preview tools). Excluded from
  // tsconfig.app for that reason, so their `node:`/tooling imports typecheck
  // without leaking Node globals into the app.
  "include": ["vite.config.ts", "src/**/build.ts", "src/**/*.node.ts"]
}
